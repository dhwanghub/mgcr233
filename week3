    <section class="study">
      <div class="study-head">
        <div>
          <h2 class="section-title" style="margin-bottom:0;">Study Materials</h2>
          <p>Use these before opening the graded practice questions.</p>
        </div>
      </div>
      <div class="study-tabs" id="study-tabs"></div>
      <div class="study-block">
        <div class="study-label"><h3>Concept Flash Cards</h3><span>Core ideas to remember</span></div>
        <div class="concept-grid" id="concept-grid"></div>

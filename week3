  <div id="quiz-view" class="quiz-view">
    <button class="back-link" id="back-btn">&larr; Back to main page</button>
    <div class="quiz-header">
      <h2 id="quiz-title"></h2>
      <p>Answer all 20 questions before grading. Solutions remain hidden until the full set is complete.</p>
    </div>
    <div class="quiz-progress" id="quiz-progress"></div>
    <div id="quiz-root"></div>
    <div class="grade-bar">
      <div class="hint" id="grade-hint">Answer all questions to unlock grading and explanations.</div>
      <button class="btn" id="grade-btn" disabled>Submit answers</button>
    </div>
    <div class="score-line" id="score-line">
      <div class="score" id="score-score">0/0</div>
      <div class="msg" id="score-msg"></div>
    </div>
  </div>

  <footer>MGCR233 practice activities &middot; based on weekly course material</footer>
</div>

<script>
const WEEKS = [
  {
    id: "w1",
    title: "Introduction to Python",
    sub: "Programming basics, statements, output, and common errors",
    concepts: [
      { title: "Input, Process, Output", text: "A simple program often receives input, performs a process, and produces output. Variables let the program refer to values while those steps happen." },
      { title: "Statements and Expressions", text: "A statement is an instruction Python executes. An expression is code that evaluates to a value, such as 4 + 3 or price * quantity." },
      { title: "Assignment and Comparison", text: "The = operator assigns a value to a name. The == operator compares two values and produces True or False." },
      { title: "Errors", text: "Syntax and indentation problems can prevent code from running. Other exceptions happen during execution. A logic error is different because the code can run and still produce the wrong result." }
    ],
    examples: [
      { title: "Example 1: Assignment and output", code: "price = 8\nquantity = 3\ntotal = price * quantity\nprint(total)", text: "Python assigns 8 to price and 3 to quantity, computes 24, assigns it to total, then prints 24." },
      { title: "Example 2: Reassignment", code: "hours = 40\nhours = 35\nprint(hours)", text: "The name hours is reassigned to 35, so print(hours) displays 35." },
      { title: "Example 3: A runtime exception", code: "sales = 100\ndays = 0\nprint(sales / days)", text: "The code is syntactically valid, but division by zero raises ZeroDivisionError when the line is executed." }
    ],
    questions: [
      {type:"programming",topic:"output",prompt:"What does this code print?\nx = 4\ny = 3\nprint(x + y)",options:["7","43","x + y","Error"],correct:0,explain:"x is 4 and y is 3, so x + y evaluates to 7 and print() displays 7."},
      {type:"programming",topic:"assignment",prompt:"What is the final value of total?\nprice = 5\nquantity = 4\ntotal = price * quantity",options:["9","20","54","Error"],correct:1,explain:"price * quantity evaluates to 5 * 4, so total is assigned 20."},
      {type:"programming",topic:"reassignment",prompt:"What does this code print?\nx = 10\nx = x + 5\nprint(x)",options:["10","15","105","Error"],correct:1,explain:"The expression x + 5 uses the current value 10. The result 15 is then assigned back to x."},
      {type:"programming",topic:"reassignment",prompt:"What does this code print?\na = 2\nb = a\na = 7\nprint(b)",options:["2","7","9","Error"],correct:0,explain:"b is assigned the value referred to by a at that time, which is 2. Reassigning a later does not change b."},
      {type:"programming",topic:"print",prompt:"Which line correctly displays the value stored in score?",options:["display(score)","print(score)","output = score","score.print()"],correct:1,explain:"print(score) passes the current value of score to Python's print() function."},
      {type:"programming",topic:"equality",prompt:"What does this code print?\nx = 5\nprint(x == 5)",options:["5","True","False","Error"],correct:1,explain:"== compares values. Since x currently refers to 5, x == 5 evaluates to True."},
      {type:"programming",topic:"comparison",prompt:"What does this code print?\nx = 10\nprint(x < 10)",options:["True","False","10","Error"],correct:1,explain:"The operator < means strictly less than. Since 10 is not less than 10, the result is False."},
      {type:"programming",topic:"comparison",prompt:"What does this code print?\nx = 10\nprint(x <= 10)",options:["True","False","10","Error"],correct:0,explain:"The operator <= includes equality. Since x equals 10, x <= 10 is True."},
      {type:"programming",topic:"syntax error",prompt:"What happens when Python 3 runs this line?\nprint \"Hello\"",options:["It prints Hello","It raises SyntaxError","It raises NameError","It prints \"Hello\" including quotation marks"],correct:1,explain:"In Python 3, print is a function and requires parentheses around its argument. This form is invalid syntax."},
      {type:"programming",topic:"name error",prompt:"Assume Monday has not been defined. What happens here?\nweekday = Monday",options:["weekday stores the text Monday","Python raises NameError","Python raises TypeError","weekday becomes 0"],correct:1,explain:"Without quotation marks, Python treats Monday as a name. Because that name is undefined, Python raises NameError."},
      {type:"programming",topic:"value error",prompt:"What happens when this line is executed?\nage = int(\"twenty\")",options:["age becomes 20","age becomes 0","Python raises ValueError","Python raises SyntaxError"],correct:2,explain:"int() cannot convert the string \"twenty\" into an integer, so it raises ValueError."},
      {type:"programming",topic:"type error",prompt:"What happens here?\nresult = 10 + \"5\"",options:["result becomes 15","result becomes \"105\"","Python raises TypeError","Python raises NameError"],correct:2,explain:"Python does not add an integer and a string with +. The incompatible operand types cause TypeError."},
      {type:"programming",topic:"zero division",prompt:"What happens here?\nnumber = 10 / 0",options:["number becomes 0","number becomes infinity","Python raises ZeroDivisionError","Python raises SyntaxError"],correct:2,explain:"Division by zero is not defined for these numeric values, so Python raises ZeroDivisionError during execution."},
      {type:"programming",topic:"logic error",prompt:"A store wants revenue = price * quantity. The programmer writes:\nrevenue = price + quantity\nThe code runs. What kind of problem is this?",options:["SyntaxError","NameError","Logic error","IndentationError"],correct:2,explain:"The instruction is valid Python, but it uses the wrong operation for the intended calculation. That makes it a logic error."},
      {type:"programming",topic:"output precision",prompt:"The required output is exactly: Total: 25\nWhich line produces that text when total = 25?",options:["print(\"Total:\", total)","print(\"Total\", total)","print(total, \"Total:\")","print(\"Total:25\")"],correct:0,explain:"print(\"Total:\", total) inserts one space between its two arguments, producing exactly Total: 25."},
      {type:"logic",topic:"program structure",prompt:"A program asks for a price, multiplies it by a quantity, then displays the total. Which sequence best describes the flow?",options:["Output, input, process","Input, process, output","Process, output, input","Variable, error, output"],correct:1,explain:"The program first receives information, then computes with it, then displays the result. That is input, process, output."},
      {type:"logic",topic:"interpreter and script",prompt:"Why is a saved Python script usually more practical than entering a longer program line by line in the interactive interpreter?",options:["Scripts can be edited, saved, and rerun as a complete program","The interpreter cannot run Python","Scripts never contain errors","The interpreter cannot display output"],correct:0,explain:"A script keeps the program in a file, which makes it easier to edit, rerun, and share. The interpreter is still useful for quick experiments."},
      {type:"logic",topic:"statement",prompt:"Which description best fits a Python statement?",options:["An instruction Python can execute","A value that must be numeric","Only text inside print()","A name that cannot change"],correct:0,explain:"A statement is an instruction Python executes. Statements can include assignments, function calls, and other forms."},
      {type:"logic",topic:"expression",prompt:"Which item is an expression because it evaluates to a value?",options:["4 + 3","A comment describing the program","The name of a Python file","An error message"],correct:0,explain:"4 + 3 is an expression because Python evaluates it and obtains the value 7."},
      {type:"logic",topic:"debugging",prompt:"Which situation can be hardest to notice immediately?",options:["A SyntaxError that stops the program","A NameError that stops the program","A logic error that produces a plausible but wrong result","An IndentationError reported by Python"],correct:2,explain:"A logic error may not produce an exception. The program can finish normally while giving an incorrect result, so the programmer must check the logic and output."}
    ]
  },
  {
    id: "w2",
    title: "Variables and Expressions",
    sub: "Objects, numeric types, operators, formatting, math, and random",
    concepts: [
      { title: "Variables and Objects", text: "A variable is a name bound to an object. Python objects have a value, a type, and an identity." },
      { title: "Numeric Operators", text: "/ performs true division. // performs floor division. % gives the modulo result. For positive integers, modulo matches the familiar remainder." },
      { title: "Precedence", text: "Parentheses can control evaluation order. Exponentiation is evaluated before multiplication or division, which are evaluated before addition or subtraction." },
      { title: "Conversion and Rounding", text: "int() truncates a float toward zero. round(x, n) rounds to n decimal places. Exact halfway cases follow round-to-even behavior, subject to floating-point representation." }
    ],
    examples: [
      { title: "Example 1: Division operators", code: "print(17 / 5)\nprint(17 // 5)\nprint(17 % 5)", text: "The outputs are 3.4, 3, and 2. These operators answer different questions, so choose the one that matches the task." },
      { title: "Example 2: Precedence", code: "result = 3 + 2 * (5 - 1) ** 2\nprint(result)", text: "Parentheses give 4, exponentiation gives 16, multiplication gives 32, and addition gives 35." },
      { title: "Example 3: Formatting", code: "pi = 3.14159265\nprint(f\"{pi:.3f}\")", text: "The format .3f displays three digits after the decimal point, so the output is 3.142." }
    ],
    questions: [
      {type:"programming",topic:"assignment",prompt:"What is the final value of x?\nx = 5\nx = x + 3\nx = x * 2",options:["8","10","16","Error"],correct:2,explain:"x becomes 8 after x = x + 3, then 16 after x = x * 2."},
      {type:"programming",topic:"augmented assignment",prompt:"What does this code print?\nx = 10\nx += 2\nx *= 3\nprint(x)",options:["30","36","32","16"],correct:1,explain:"x += 2 changes x from 10 to 12. Then x *= 3 changes 12 to 36."},
      {type:"programming",topic:"true division",prompt:"What does this code print?\nprint(7 / 2)",options:["3","3.0","3.5","4"],correct:2,explain:"The / operator performs true division, so 7 / 2 evaluates to the float 3.5."},
      {type:"programming",topic:"floor division",prompt:"What does this code print?\nprint(17 // 5)",options:["3","3.4","4","2"],correct:0,explain:"17 / 5 is 3.4. Floor division // returns the greatest integer not greater than that result, which is 3."},
      {type:"programming",topic:"modulo",prompt:"What does this code print?\nprint(17 % 5)",options:["2","3","3.4","5"],correct:0,explain:"17 can be written as 5 * 3 + 2, so 17 % 5 is 2."},
      {type:"programming",topic:"digit extraction",prompt:"Given x = 237, which expression evaluates to the tens digit 3?",options:["x % 10","(x // 10) % 10","x // 100","x % 1000"],correct:1,explain:"x // 10 gives 23. Then 23 % 10 gives 3, the tens digit."},
      {type:"programming",topic:"precedence",prompt:"What is the value of result?\nresult = 3 + 2 * 4",options:["20","11","14","24"],correct:1,explain:"Multiplication is evaluated before addition, so 2 * 4 is 8 and 3 + 8 is 11."},
      {type:"programming",topic:"precedence",prompt:"Evaluate this expression:\n3 + 2 * (5 - 1) ** 2",options:["35","32","20","13"],correct:0,explain:"(5 - 1) is 4, 4 ** 2 is 16, 2 * 16 is 32, and 3 + 32 is 35."},
      {type:"programming",topic:"float type",prompt:"What does this code print?\nx = 1\ny = 2\nz = x / y\nprint(type(z))",options:["<class 'int'>","<class 'float'>","0.5","Error"],correct:1,explain:"For numeric operands, / returns a float. Therefore z is 0.5 and type(z) is float."},
      {type:"programming",topic:"formatting",prompt:"What does this code print?\npi = 3.14159265\nprint(f\"{pi:.3f}\")",options:["3.14","3.142","3.14159265","3"],correct:1,explain:".3f formats the value with three digits after the decimal point. For this value, the displayed result is 3.142."},
      {type:"programming",topic:"round",prompt:"What does this expression return?\nround(4.567, 2)",options:["4.5","4.56","4.57","5"],correct:2,explain:"Rounding 4.567 to two digits after the decimal point gives 4.57."},

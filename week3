<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MGCR 233 | Practice</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --red:#E01F2E;
    --red-dark:#B0121F;
    --black:#202124;
    --gray:#5F6368;
    --gray-light:#7A7F87;
    --line:#E2E5E9;
    --paper:#FFFFFF;
    --off:#F8F9FA;
    --soft-red:#FFF7F8;
    --correct-bg:#EAF7EE;
    --correct-line:#2E8B4F;
    --wrong-bg:#FDECEC;
    --wrong-line:#C62828;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--paper);color:var(--black);font-family:'Inter',sans-serif;line-height:1.55;}
  h1,h2,h3,h4,p{margin-top:0;}
  a{color:inherit;}
  button{font-family:inherit;}
  code,pre{font-family:'Courier New',monospace;}
  .wrap{max-width:860px;margin:0 auto;padding:0 28px;}

  .hero{background:var(--paper);padding:52px 28px 42px;border-top:6px solid var(--red);border-bottom:1px solid var(--line);}
  .hero-inner{max-width:860px;margin:0 auto;}
  .hero .course-code{font-size:13px;font-weight:700;letter-spacing:.03em;color:var(--red);margin-bottom:9px;}
  .hero h1{font-size:32px;line-height:1.2;letter-spacing:-.02em;margin-bottom:8px;}
  .hero p{font-size:14px;color:var(--gray);margin:0;}

  .info{padding:36px 0 10px;}
  .section-title{font-size:18px;margin-bottom:16px;}
  .info-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.8fr);gap:40px;border-top:1px solid var(--line);padding-top:18px;}
  .info-main,.info-support{display:grid;gap:16px;}
  .info-support{border-left:1px solid var(--line);padding-left:28px;}
  .info-item .k{font-size:12px;color:var(--gray-light);margin-bottom:3px;}
  .info-item .v{font-size:14px;font-weight:500;}
  .info-item .v a{color:var(--red);text-decoration:none;}
  .info-item .v a:hover{text-decoration:underline;}

  .study{padding:36px 0 16px;}
  .study-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px;}
  .study-head p{font-size:13px;color:var(--gray);margin:4px 0 0;}
  .study-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px;}
  .study-tab{border:1px solid var(--line);background:var(--paper);color:var(--gray);font-size:13px;font-weight:600;padding:8px 12px;border-radius:4px;cursor:pointer;}
  .study-tab:hover{border-color:#B9BDC4;}
  .study-tab.active{border-color:var(--red);color:var(--red);background:var(--soft-red);}
  .study-block{margin-bottom:28px;}
  .study-label{display:flex;align-items:baseline;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line);padding-bottom:9px;margin-bottom:12px;}
  .study-label h3{font-size:15px;margin:0;}
  .study-label span{font-size:12px;color:var(--gray-light);}

  .concept-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;}
  .concept-card{border:1px solid var(--line);border-radius:6px;padding:16px;background:var(--paper);min-height:132px;}
  .concept-card .card-kicker{font-size:11px;font-weight:700;color:var(--red);margin-bottom:9px;text-transform:uppercase;letter-spacing:.03em;}
  .concept-card h4{font-size:14px;margin-bottom:7px;}
  .concept-card p{font-size:13px;color:var(--gray);margin:0;line-height:1.5;}

  .example-list{display:grid;gap:10px;}
  .example-card{border:1px solid var(--line);border-radius:6px;padding:16px;background:var(--off);}
  .example-card h4{font-size:14px;margin-bottom:9px;}
  .example-card pre{margin:0 0 10px;background:var(--paper);border:1px solid var(--line);padding:11px 12px;border-radius:4px;font-size:13px;white-space:pre-wrap;overflow-x:auto;line-height:1.5;}
  .example-card p{font-size:13px;color:var(--gray);margin:0;}

  .modules{padding:34px 0 88px;}
  .modules-head{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:4px;gap:16px;}
  .modules-head h2{font-size:18px;}
  .modules-head .note{font-size:12px;color:var(--gray-light);}
  .module-row{display:flex;align-items:center;gap:18px;padding:20px 4px;border-bottom:1px solid var(--line);cursor:pointer;transition:background .15s ease,padding .15s ease;}
  .module-row:hover{background:var(--off);padding-left:10px;padding-right:10px;}
  .module-row .m-num{font-size:21px;font-weight:800;color:var(--red);min-width:32px;}
  .module-row .m-body{flex:1;}
  .module-row .m-title{font-size:16px;font-weight:700;}
  .module-row .m-sub{font-size:13px;color:var(--gray);margin-top:3px;}
  .module-row .m-count{font-size:12px;color:var(--gray-light);white-space:nowrap;}

  .quiz-view{display:none;padding:42px 0 100px;}
  .quiz-view.show{display:block;}
  .modules-root.hide{display:none;}
  .back-link{display:inline-block;font-size:13px;color:var(--gray);margin-bottom:26px;cursor:pointer;border:none;background:none;padding:0;font-weight:600;}
  .back-link:hover{color:var(--red);}
  .quiz-header{border-bottom:1px solid var(--line);padding-bottom:16px;margin-bottom:0;}
  .quiz-header h2{font-size:24px;margin-bottom:5px;}
  .quiz-header p{font-size:13px;color:var(--gray);margin:0;}
  .quiz-progress{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);margin:0;padding:13px 0;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--gray);}
  .quiz-progress strong{color:var(--black);}
  .question-section{font-size:13px;font-weight:700;color:var(--red);letter-spacing:.02em;text-transform:uppercase;padding:30px 0 4px;}
  .question{padding:26px 0;border-bottom:1px solid var(--line);}
  .q-row{display:flex;gap:16px;}
  .q-index{font-size:17px;font-weight:800;color:var(--red);min-width:28px;}
  .q-body{flex:1;min-width:0;}
  .q-prompt{font-size:15px;margin-bottom:5px;white-space:pre-wrap;}
  .q-prompt code{background:var(--off);border:1px solid var(--line);padding:1px 5px;border-radius:3px;font-size:13px;}
  .q-topic{font-size:11px;color:var(--gray-light);margin-bottom:13px;text-transform:uppercase;letter-spacing:.02em;}
  .options{display:flex;flex-direction:column;gap:8px;}
  .option{display:flex;align-items:flex-start;gap:10px;padding:10px 13px;border:1px solid var(--line);border-radius:4px;cursor:pointer;background:var(--paper);transition:border-color .12s ease,background .12s ease;}
  .option:hover{border-color:#B9BDC4;background:var(--off);}
  .option input{margin-top:3px;accent-color:var(--red);}
  .option .label{font-size:14px;white-space:pre-wrap;}
  .option.is-correct{border-color:var(--correct-line);background:var(--correct-bg);}
  .option.is-wrong{border-color:var(--wrong-line);background:var(--wrong-bg);}
  .q-feedback{margin-top:12px;font-size:13px;color:var(--gray);display:none;line-height:1.55;}
  .q-feedback.show{display:block;}
  .verdict{display:inline-block;font-size:11px;padding:2px 7px;border-radius:3px;margin-right:8px;font-weight:700;text-transform:uppercase;}
  .verdict.right{background:var(--correct-bg);color:var(--correct-line);border:1px solid var(--correct-line);}
  .verdict.wrong{background:var(--wrong-bg);color:var(--wrong-line);border:1px solid var(--wrong-line);}

  .grade-bar{margin-top:36px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:6px;}
  .grade-bar .hint{font-size:13px;color:var(--gray);max-width:520px;}
  .btn{font-size:14px;font-weight:600;padding:12px 22px;border-radius:4px;border:1px solid var(--red);background:var(--red);color:#fff;cursor:pointer;transition:background .15s ease,opacity .15s ease;}
  .btn:hover:not(:disabled){background:var(--red-dark);border-color:var(--red-dark);}
  .btn:disabled{cursor:not-allowed;opacity:.38;background:var(--red);}
  .score-line{display:none;margin-top:32px;padding:18px 20px;border:1px solid var(--line);background:var(--off);border-radius:5px;align-items:center;gap:16px;}
  .score-line.show{display:flex;}
  .score-line .score{font-size:25px;font-weight:800;color:var(--red);}
  .score-line .msg{font-size:13px;}

  footer{text-align:center;padding:32px 0 56px;font-size:12px;color:var(--gray-light);border-top:1px solid var(--line);}
  @media (max-width:620px){
    .wrap{padding:0 20px;}
    .info-grid,.concept-grid{grid-template-columns:1fr;}
    .info-support{border-left:0;border-top:1px solid var(--line);padding-left:0;padding-top:16px;}
    .study-head,.modules-head{align-items:flex-start;flex-direction:column;gap:5px;}
    .module-row{gap:12px;}
    .module-row .m-count{display:none;}
  }
</style>
</head>
<body>
<div class="hero">
  <div class="hero-inner">
    <div class="course-code">MGCR233</div>
    <h1>Data Programming for Business</h1>
    <p>Review the concepts, work through examples, then complete the practice set.</p>
  </div>
</div>

<div class="wrap">
  <div id="modules-root" class="modules-root">
    <section class="info">
      <h2 class="section-title">Course Information</h2>
      <div class="info-grid">
        <div class="info-main">
          <div class="info-item"><div class="k">Term and year</div><div class="v">Fall 2026</div></div>
          <div class="info-item"><div class="k">Course schedule</div><div class="v">Tuesday and Thursday, 8:35 AM to 9:55 AM</div></div>
        </div>
        <div class="info-support">
          <div class="info-item"><div class="k">Need help?</div><div class="v"><a href="mailto:dugmee.hwang@mcgill.ca">dugmee.hwang@mcgill.ca</a></div></div>
          <div class="info-item"><div class="k">Discussion needed?</div><div class="v"><a href="https://mycourses2.mcgill.ca/d2l/le/879465/discussions/List" target="_blank" rel="noopener noreferrer">myCourses Discussion Board</a></div></div>
        </div>
      </div>

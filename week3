const listEl = document.getElementById('module-list');
const modulesRoot = document.getElementById('modules-root');
const quizView = document.getElementById('quiz-view');
const quizRoot = document.getElementById('quiz-root');
const quizTitle = document.getElementById('quiz-title');
const quizProgress = document.getElementById('quiz-progress');
const scoreLine = document.getElementById('score-line');
const scoreScore = document.getElementById('score-score');
const scoreMsg = document.getElementById('score-msg');
const gradeBtn = document.getElementById('grade-btn');
const gradeHint = document.getElementById('grade-hint');
const studyTabs = document.getElementById('study-tabs');
const conceptGrid = document.getElementById('concept-grid');
const exampleList = document.getElementById('example-list');

let currentWeek = null;
let currentStudyWeek = WEEKS[0];
let answers = [];
let graded = false;

function escapeHtml(str){
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function renderWeekList(){
  listEl.innerHTML = '';
  WEEKS.forEach((m, i) => {
    const row = document.createElement('div');
    row.className = 'module-row';
    row.innerHTML = `
      <div class="m-num">${String(i + 1).padStart(2, '0')}</div>
      <div class="m-body">
        <div class="m-title">Week ${i + 1}: ${escapeHtml(m.title)}</div>
        <div class="m-sub">${escapeHtml(m.sub)}</div>
      </div>
      <div class="m-count">15 programming + 5 logic</div>`;
    row.addEventListener('click', () => openWeek(m));
    listEl.appendChild(row);
  });
}

function renderStudyTabs(){
  studyTabs.innerHTML = '';
  WEEKS.forEach((m, i) => {
    const btn = document.createElement('button');
    btn.className = 'study-tab' + (m.id === currentStudyWeek.id ? ' active' : '');
    btn.textContent = `Week ${i + 1}: ${m.title}`;
    btn.addEventListener('click', () => {
      currentStudyWeek = m;
      renderStudyTabs();
      renderStudyMaterials();
    });
    studyTabs.appendChild(btn);
  });
}

function renderStudyMaterials(){
  conceptGrid.innerHTML = '';
  currentStudyWeek.concepts.forEach((item, i) => {
    const card = document.createElement('div');
    card.className = 'concept-card';
    card.innerHTML = `<div class="card-kicker">Concept ${String(i + 1).padStart(2,'0')}</div><h4>${escapeHtml(item.title)}</h4><p>${escapeHtml(item.text)}</p>`;
    conceptGrid.appendChild(card);
  });

  exampleList.innerHTML = '';
  currentStudyWeek.examples.forEach(item => {
    const card = document.createElement('div');
    card.className = 'example-card';
    card.innerHTML = `<h4>${escapeHtml(item.title)}</h4><pre>${escapeHtml(item.code)}</pre><p>${escapeHtml(item.text)}</p>`;
    exampleList.appendChild(card);
  });
}

function openWeek(m){
  currentWeek = m;
  answers = new Array(m.questions.length).fill(null);
  graded = false;
  quizTitle.textContent = `Week ${WEEKS.indexOf(m) + 1}: ${m.title}`;
  scoreLine.classList.remove('show');
  gradeBtn.disabled = true;
  gradeHint.textContent = 'Answer all questions to unlock grading and explanations.';
  renderQuiz();
  modulesRoot.classList.add('hide');
  quizView.classList.add('show');
  window.scrollTo({top:0,behavior:'smooth'});
}

function closeWeek(){
  modulesRoot.classList.remove('hide');
  quizView.classList.remove('show');
  window.scrollTo({top:0,behavior:'smooth'});
}

function updateProgress(){
  const answered = answers.filter(a => a !== null).length;
  const total = currentWeek.questions.length;
  const remaining = total - answered;
  quizProgress.innerHTML = `<strong>${answered} of ${total}</strong> answered${remaining > 0 ? ` &nbsp;·&nbsp; ${remaining} remaining` : ' &nbsp;·&nbsp; Ready to submit'}`;
  gradeBtn.disabled = remaining !== 0 || graded;
  if (!graded) {
    gradeHint.textContent = remaining === 0
      ? 'All questions are answered. You can now submit and review the explanations.'
      : `Complete the remaining ${remaining} question${remaining === 1 ? '' : 's'} before solutions can be shown.`;
  }
}

function clearFeedback(qi){
  if (!graded) return;
  const fb = document.getElementById('feedback-' + qi);
  fb.classList.remove('show');
  fb.innerHTML = '';
  document.querySelectorAll(`.option[data-qi="${qi}"]`).forEach(o => o.classList.remove('is-correct','is-wrong'));
}

function renderQuiz(){
  quizRoot.innerHTML = '';
  currentWeek.questions.forEach((q, qi) => {
    if (qi === 0 || qi === 15) {
      const section = document.createElement('div');
      section.className = 'question-section';
      section.textContent = qi === 0 ? 'Programming Practice · Questions 1 to 15' : 'Concept and Logic · Questions 16 to 20';
      quizRoot.appendChild(section);
    }

    const qDiv = document.createElement('div');
    qDiv.className = 'question';
    const row = document.createElement('div');
    row.className = 'q-row';
    const idx = document.createElement('div');
    idx.className = 'q-index';
    idx.textContent = String(qi + 1).padStart(2,'0');
    const body = document.createElement('div');
    body.className = 'q-body';
    const prompt = document.createElement('div');
    prompt.className = 'q-prompt';
    prompt.textContent = q.prompt;
    const topic = document.createElement('div');
    topic.className = 'q-topic';
    topic.textContent = q.topic;
    const opts = document.createElement('div');
    opts.className = 'options';

    q.options.forEach((optText, oi) => {
      const label = document.createElement('label');
      label.className = 'option';
      label.dataset.qi = qi;
      label.dataset.oi = oi;
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = 'q' + qi;
      input.value = oi;
      input.addEventListener('change', () => {
        if (graded) return;
        answers[qi] = oi;
        updateProgress();
      });
      const span = document.createElement('span');
      span.className = 'label';
      span.textContent = optText;
      label.appendChild(input);
      label.appendChild(span);
      opts.appendChild(label);
    });

    const feedback = document.createElement('div');
    feedback.className = 'q-feedback';
    feedback.id = 'feedback-' + qi;
    body.appendChild(prompt);
    body.appendChild(topic);
    body.appendChild(opts);
    body.appendChild(feedback);
    row.appendChild(idx);
    row.appendChild(body);
    qDiv.appendChild(row);
    quizRoot.appendChild(qDiv);
  });
  updateProgress();
}

gradeBtn.addEventListener('click', () => {
  if (answers.some(a => a === null)) {
    updateProgress();
    return;
  }

  graded = true;
  gradeBtn.disabled = true;
  let score = 0;

  currentWeek.questions.forEach((q, qi) => {
    const chosen = answers[qi];
    const isRight = chosen === q.correct;
    if (isRight) score++;

    document.querySelectorAll(`.option[data-qi="${qi}"]`).forEach(optEl => {
      const oi = Number(optEl.dataset.oi);
      const input = optEl.querySelector('input');
      input.disabled = true;
      if (oi === q.correct) optEl.classList.add('is-correct');
      else if (oi === chosen) optEl.classList.add('is-wrong');
    });

    const fb = document.getElementById('feedback-' + qi);
    fb.innerHTML = isRight
      ? `<span class="verdict right">Correct</span>${escapeHtml(q.explain)}`
      : `<span class="verdict wrong">Review</span>${escapeHtml(q.explain)}`;
    fb.classList.add('show');
  });

  scoreScore.textContent = `${score}/${currentWeek.questions.length}`;
  scoreMsg.textContent = score === currentWeek.questions.length
    ? 'Excellent work. Every answer is correct.'
    : 'Review the explanations below each question and focus on the reasoning behind the marked items.';
  gradeHint.textContent = 'Grading is complete. Explanations are now visible.';
  scoreLine.classList.add('show');
  scoreLine.scrollIntoView({behavior:'smooth',block:'nearest'});
});

document.getElementById('back-btn').addEventListener('click', closeWeek);
renderWeekList();
renderStudyTabs();
renderStudyMaterials();
</script>
